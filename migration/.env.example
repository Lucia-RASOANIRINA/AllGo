# Outillage de migration — variables d'environnement.
# Copier en .env et renseigner. AUCUNE valeur réelle n'est versionnée (§12.1).

# --- Base en ligne (site web actuel) ---
# Variables séparées plutôt qu'une URL unique : un mot de passe contenant
# des caractères spéciaux (@, ;, {, }...) casserait le format mysql://user:pass@host.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
# Optionnel : si vide, le script liste les bases accessibles à cet
# utilisateur au lieu d'en présumer une.
MYSQL_DATABASE=

# --- Clone local MongoDB (cible de la migration progressive) ---
MONGODB_URI=mongodb://localhost:27017/allgo?replicaSet=rs0&directConnection=true
