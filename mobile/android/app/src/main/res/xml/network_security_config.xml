<?xml version="1.0" encoding="utf-8"?>
<!--
  Politique réseau.

  Android 9 et suivants refusent le HTTP en clair par défaut, et c'est une
  bonne chose : l'API de production est en HTTPS uniquement (§12.2, épinglage
  de certificat compris).

  L'exception ci-dessous est strictement bornée aux hôtes de développement —
  `10.0.2.2` est l'alias de la machine hôte vu depuis l'émulateur Android.
  Activer `usesCleartextTraffic="true"` sur toute l'application aurait été plus
  court et aurait ouvert le HTTP vers n'importe quel serveur, y compris en
  production.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
