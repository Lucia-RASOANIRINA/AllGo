generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model addresses {
  id           Int      @id @default(autoincrement())
  user_id      Int
  label        String?  @db.VarChar(100)
  city         String?  @db.VarChar(100)
  district     String?  @db.VarChar(100)
  address_line String?  @db.VarChar(255)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  is_default   Boolean? @default(false)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "addresses_ibfk_1")
  orders       orders[]

  @@index([user_id], map: "user_id")
}

model admin_logs {
  id          Int       @id @default(autoincrement())
  admin_id    Int
  action      String    @db.VarChar(255)
  target_type String?   @db.VarChar(50)
  target_id   Int?
  created_at  DateTime? @default(now()) @db.DateTime(0)
  users       users     @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "admin_logs_ibfk_1")

  @@index([admin_id], map: "admin_id")
}

model advertisements {
  id         Int                    @id @default(autoincrement())
  shop_id    Int?
  title      String                 @db.VarChar(150)
  image      String?                @db.VarChar(255)
  target_url String?                @db.VarChar(255)
  starts_at  DateTime?              @db.DateTime(0)
  ends_at    DateTime?              @db.DateTime(0)
  status     advertisements_status? @default(active)
  shops      shops?                 @relation(fields: [shop_id], references: [id], onUpdate: Restrict, map: "advertisements_ibfk_1")

  @@index([shop_id], map: "shop_id")
}

model cart {
  id               Int               @id @default(autoincrement())
  user_id          Int
  product_id       Int
  variant_id       Int?
  quantity         Int               @default(1)
  created_at       DateTime?         @default(now()) @db.DateTime(0)
  users            users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_ibfk_1")
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_ibfk_2")
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: Restrict, map: "cart_ibfk_3")

  @@index([product_id], map: "product_id")
  @@index([user_id], map: "user_id")
  @@index([variant_id], map: "variant_id")
}

model categories {
  id               Int          @id @default(autoincrement())
  parent_id        Int?
  name             String       @db.VarChar(100)
  slug             String       @unique(map: "slug") @db.VarChar(120)
  icon             String?      @db.VarChar(255)
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: Restrict, map: "categories_ibfk_1")
  other_categories categories[] @relation("categoriesTocategories")
  posts            posts[]
  products         products[]
  shops            shops[]

  @@index([parent_id], map: "parent_id")
}

model client_requests {
  id           Int                     @id @default(autoincrement())
  user_id      Int
  type         client_requests_type    @default(search)
  title        String                  @db.VarChar(180)
  description  String                  @db.Text
  category_id  Int?
  quantity     String?                 @db.VarChar(60)
  location     String?                 @db.VarChar(150)
  budget       Decimal?                @db.Decimal(12, 2)
  desired_date DateTime?               @db.Date
  urgency      client_requests_urgency @default(normal)
  status       client_requests_status  @default(active)
  views        Int                     @default(0)
  created_at   DateTime?               @default(now()) @db.DateTime(0)
  updated_at   DateTime?               @default(now()) @db.DateTime(0)

  @@index([status], map: "idx_cr_status")
  @@index([urgency], map: "idx_cr_urgency")
  @@index([user_id], map: "idx_cr_user")
}

model comments {
  id             Int        @id @default(autoincrement())
  post_id        Int
  user_id        Int
  parent_id      Int?
  content        String     @db.Text
  created_at     DateTime?  @default(now()) @db.DateTime(0)
  posts          posts      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_1")
  users          users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_2")
  comments       comments?  @relation("commentsTocomments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_3")
  other_comments comments[] @relation("commentsTocomments")

  @@index([parent_id], map: "parent_id")
  @@index([post_id], map: "post_id")
  @@index([user_id], map: "user_id")
}

model contact_messages {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(150)
  email      String    @db.VarChar(150)
  subject    String?   @db.VarChar(200)
  message    String    @db.Text
  is_read    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.DateTime(0)
}

model conversations {
  id                                     Int        @id @default(autoincrement())
  user_one_id                            Int
  user_two_id                            Int
  created_at                             DateTime?  @default(now()) @db.DateTime(0)
  blocked_by_user_one_at                 DateTime?  @db.DateTime(0)
  blocked_by_user_two_at                 DateTime?  @db.DateTime(0)
  archived_by_user_one_at                DateTime?  @db.DateTime(0)
  archived_by_user_two_at                DateTime?  @db.DateTime(0)
  users_conversations_user_one_idTousers users      @relation("conversations_user_one_idTousers", fields: [user_one_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "conversations_ibfk_1")
  users_conversations_user_two_idTousers users      @relation("conversations_user_two_idTousers", fields: [user_two_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "conversations_ibfk_2")
  messages                               messages[]

  @@unique([user_one_id, user_two_id], map: "unique_conversation")
  @@index([user_two_id], map: "user_two_id")
}

model coupons {
  id             Int                    @id @default(autoincrement())
  shop_id        Int?
  code           String                 @unique(map: "code") @db.VarChar(50)
  discount_type  coupons_discount_type? @default(percent)
  discount_value Decimal                @db.Decimal(12, 2)
  expires_at     DateTime?              @db.DateTime(0)
  usage_limit    Int?
  used_count     Int?                   @default(0)
  shops          shops?                 @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "coupons_ibfk_1")

  @@index([shop_id], map: "shop_id")
}

model favorites {
  id         Int       @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime? @default(now()) @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "favorites_ibfk_1")
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "favorites_ibfk_2")

  @@unique([user_id, product_id], map: "unique_fav")
  @@index([product_id], map: "product_id")
}

model followers {
  id                                  Int       @id @default(autoincrement())
  follower_id                         Int
  following_id                        Int
  created_at                          DateTime? @default(now()) @db.DateTime(0)
  users_followers_follower_idTousers  users     @relation("followers_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "followers_ibfk_1")
  users_followers_following_idTousers users     @relation("followers_following_idTousers", fields: [following_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "followers_ibfk_2")

  @@unique([follower_id, following_id], map: "unique_follow_user")
  @@index([following_id], map: "following_id")
}

model hashtags {
  id            Int             @id @default(autoincrement())
  name          String          @unique(map: "name") @db.VarChar(100)
  post_hashtags post_hashtags[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model kyc_documents {
  id               Int                     @id @default(autoincrement())
  user_id          Int
  role_type        kyc_documents_role_type @default(client)
  document_type    String                  @db.VarChar(50)
  file_path        String                  @db.VarChar(255)
  original_name    String                  @db.VarChar(255)
  mime_type        String?                 @db.VarChar(100)
  file_size        Int?
  status           kyc_documents_status    @default(pending)
  rejection_reason String?                 @db.Text
  uploaded_at      DateTime                @default(now()) @db.DateTime(0)
  reviewed_at      DateTime?               @db.DateTime(0)
  reviewed_by      Int?
  created_at       DateTime                @default(now()) @db.DateTime(0)
  updated_at       DateTime                @default(now()) @db.DateTime(0)
  users            users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "kyc_documents_user_fk")

  @@index([status, role_type], map: "idx_kyc_pending")
  @@index([status], map: "status")
  @@index([user_id], map: "user_id")
}

model logs {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  action     String    @db.VarChar(255)
  ip_address String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.DateTime(0)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "logs_ibfk_1")

  @@index([user_id], map: "user_id")
}

model message_attachments {
  id         Int       @id @default(autoincrement())
  message_id Int
  url        String    @db.VarChar(255)
  type       String    @default("image") @db.VarChar(50)
  name       String?   @db.VarChar(255)
  size       Int?
  created_at DateTime? @default(now()) @db.DateTime(0)
  messages   messages  @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "message_attachments_ibfk_1")

  @@index([message_id], map: "message_id")
}

model messages {
  id                      Int                   @id @default(autoincrement())
  conversation_id         Int
  sender_id               Int
  content                 String?               @db.Text
  attachment              String?               @db.VarChar(255)
  is_read                 Boolean?              @default(false)
  edited_at               DateTime?             @db.DateTime(0)
  deleted_by_sender_at    DateTime?             @db.DateTime(0)
  deleted_by_recipient_at DateTime?             @db.DateTime(0)
  created_at              DateTime?             @default(now()) @db.DateTime(0)
  message_attachments     message_attachments[]
  conversations           conversations         @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "messages_ibfk_1")
  users                   users                 @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "messages_ibfk_2")

  @@index([conversation_id], map: "conversation_id")
  @@index([sender_id], map: "sender_id")
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String    @db.VarChar(50)
  data       String?   @db.Text
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notifications_ibfk_1")

  @@index([user_id], map: "user_id")
}

model order_items {
  id               Int               @id @default(autoincrement())
  order_id         Int
  product_id       Int
  variant_id       Int?
  quantity         Int
  unit_price       Decimal           @db.Decimal(12, 2)
  orders           orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "order_items_ibfk_1")
  products         products          @relation(fields: [product_id], references: [id], onUpdate: Restrict, map: "order_items_ibfk_2")
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: Restrict, map: "order_items_ibfk_3")

  @@index([order_id], map: "order_id")
  @@index([product_id], map: "product_id")
  @@index([variant_id], map: "variant_id")
}

model orders {
  id               Int                     @id @default(autoincrement())
  user_id          Int
  shop_id          Int
  order_number     String                  @unique(map: "order_number") @db.VarChar(50)
  total_amount     Decimal                 @db.Decimal(12, 2)
  status           orders_status?          @default(pending)
  payment_method   orders_payment_method?  @default(cod)
  payment_status   orders_payment_status?  @default(unpaid)
  delivery_method  orders_delivery_method? @default(delivery)
  delivery_address String?                 @db.VarChar(255)
  delivery_city    String?                 @db.VarChar(100)
  delivery_phone   String?                 @db.VarChar(30)
  shipping_fee     Decimal?                @default(0.00) @db.Decimal(12, 2)
  address_id       Int?
  note             String?                 @db.Text
  created_at       DateTime?               @default(now()) @db.DateTime(0)
  updated_at       DateTime?               @default(now()) @db.DateTime(0)
  order_items      order_items[]
  users            users                   @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "orders_ibfk_1")
  shops            shops                   @relation(fields: [shop_id], references: [id], onUpdate: Restrict, map: "orders_ibfk_2")
  addresses        addresses?              @relation(fields: [address_id], references: [id], onUpdate: Restrict, map: "orders_ibfk_3")
  payments         payments[]
  refunds          refunds[]
  sales_invoices   sales_invoices[]

  @@index([address_id], map: "address_id")
  @@index([shop_id], map: "shop_id")
  @@index([user_id], map: "user_id")
}

model password_resets {
  id         Int       @id @default(autoincrement())
  email      String    @db.VarChar(150)
  token      String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.DateTime(0)
}

model payments {
  id              Int              @id @default(autoincrement())
  order_id        Int
  method          String           @db.VarChar(50)
  transaction_ref String?          @db.VarChar(150)
  amount          Decimal          @db.Decimal(12, 2)
  status          payments_status? @default(pending)
  created_at      DateTime?        @default(now()) @db.DateTime(0)
  orders          orders           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "payments_ibfk_1")

  @@index([order_id], map: "order_id")
}

model post_hashtags {
  post_id    Int
  hashtag_id Int
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "post_hashtags_ibfk_1")
  hashtags   hashtags @relation(fields: [hashtag_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "post_hashtags_ibfk_2")

  @@id([post_id, hashtag_id])
  @@index([hashtag_id], map: "hashtag_id")
}

model post_media {
  id        Int              @id @default(autoincrement())
  post_id   Int
  type      post_media_type? @default(image)
  file_path String           @db.VarChar(255)
  posts     posts            @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "post_media_ibfk_1")

  @@index([post_id], map: "post_id")
}

model post_preferences {
  id         Int                   @id @default(autoincrement())
  user_id    Int
  post_id    Int
  type       post_preferences_type
  created_at DateTime?             @default(now()) @db.DateTime(0)
  users      users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "post_preferences_ibfk_1")
  posts      posts                 @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "post_preferences_ibfk_2")

  @@unique([user_id, post_id], map: "unique_preference")
  @@index([post_id], map: "post_id")
}

model posts {
  id               Int                @id @default(autoincrement())
  user_id          Int
  shop_id          Int?
  product_id       Int?
  content          String?            @db.Text
  type             posts_type?
  title            String?            @db.VarChar(255)
  description      String?            @db.Text
  category_id      Int?
  quantity         String?            @db.VarChar(100)
  budget           Decimal?           @db.Decimal(10, 2)
  desired_date     DateTime?          @db.Date
  urgency          posts_urgency?     @default(normal)
  location         String?            @db.VarChar(255)
  visibility       posts_visibility?  @default(public)
  is_announcement  Boolean?           @default(false)
  created_at       DateTime?          @default(now()) @db.DateTime(0)
  updated_at       DateTime?          @default(now()) @db.DateTime(0)
  comments         comments[]
  post_hashtags    post_hashtags[]
  post_media       post_media[]
  post_preferences post_preferences[]
  categories       categories?        @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_posts_category")
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "posts_ibfk_1")
  shops            shops?             @relation(fields: [shop_id], references: [id], onUpdate: Restrict, map: "posts_ibfk_2")
  products         products?          @relation(fields: [product_id], references: [id], onUpdate: Restrict, map: "posts_ibfk_3")
  reactions        reactions[]
  saved_posts      saved_posts[]
  shares           shares[]

  @@index([category_id], map: "fk_posts_category")
  @@index([product_id], map: "product_id")
  @@index([shop_id], map: "shop_id")
  @@index([user_id], map: "user_id")
}

model product_images {
  id         Int                       @id @default(autoincrement())
  product_id Int
  image_path String                    @db.VarChar(255)
  media_type product_images_media_type @default(image)
  is_main    Boolean?                  @default(false)
  products   products                  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "product_images_ibfk_1")

  @@index([product_id], map: "product_id")
}

model product_reviews {
  id         Int       @id @default(autoincrement())
  product_id Int
  user_id    Int
  rating     Int       @db.TinyInt
  comment    String?   @db.Text
  created_at DateTime? @default(now()) @db.DateTime(0)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "product_reviews_ibfk_1")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "product_reviews_ibfk_2")

  @@index([product_id], map: "product_id")
  @@index([user_id], map: "user_id")
}

model product_variants {
  id          Int           @id @default(autoincrement())
  product_id  Int
  name        String        @db.VarChar(100)
  value       String        @db.VarChar(100)
  extra_price Decimal?      @default(0.00) @db.Decimal(12, 2)
  stock       Int?          @default(0)
  cart        cart[]
  order_items order_items[]
  products    products      @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "product_variants_ibfk_1")

  @@index([product_id], map: "product_id")
}

model products {
  id               Int                @id @default(autoincrement())
  shop_id          Int
  category_id      Int?
  name             String             @db.VarChar(200)
  slug             String             @db.VarChar(220)
  description      String?            @db.Text
  price            Decimal            @db.Decimal(12, 2)
  promo_price      Decimal?           @db.Decimal(12, 2)
  stock            Int?               @default(0)
  status           products_status?   @default(published)
  views            Int?               @default(0)
  created_at       DateTime?          @default(now()) @db.DateTime(0)
  updated_at       DateTime?          @default(now()) @db.DateTime(0)
  cart             cart[]
  favorites        favorites[]
  order_items      order_items[]
  posts            posts[]
  product_images   product_images[]
  product_reviews  product_reviews[]
  product_variants product_variants[]
  shops            shops              @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "products_ibfk_1")
  categories       categories?        @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "products_ibfk_2")

  @@index([category_id], map: "category_id")
  @@index([shop_id], map: "shop_id")
}

model promotions {
  id          Int       @id @default(autoincrement())
  shop_id     Int
  title       String    @db.VarChar(150)
  description String?   @db.Text
  starts_at   DateTime? @db.DateTime(0)
  ends_at     DateTime? @db.DateTime(0)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  shops       shops     @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "promotions_ibfk_1")

  @@index([shop_id], map: "shop_id")
}

model reactions {
  id         Int             @id @default(autoincrement())
  post_id    Int
  user_id    Int
  type       reactions_type? @default(like)
  created_at DateTime?       @default(now()) @db.DateTime(0)
  posts      posts           @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reactions_ibfk_1")
  users      users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reactions_ibfk_2")

  @@unique([post_id, user_id], map: "unique_reaction")
  @@index([user_id], map: "user_id")
}

model refunds {
  id           Int            @id @default(autoincrement())
  order_id     Int
  shop_id      Int
  requested_by Int?
  amount       Decimal        @db.Decimal(12, 2)
  reason       String?        @db.Text
  status       refunds_status @default(pending)
  created_at   DateTime?      @default(now()) @db.DateTime(0)
  orders       orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "refunds_ibfk_1")
  shops        shops          @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "refunds_ibfk_2")

  @@index([order_id], map: "order_id")
  @@index([shop_id], map: "shop_id")
}

/// Sessions mobiles — aucun équivalent PHP (le web n'a pas de jetons de
/// rafraîchissement). Ajoutée manuellement (pas de `prisma db pull`, pour ne
/// pas reformater le reste du fichier) : garder synchronisée avec le DDL réel
/// une fois exécuté en base.
model refresh_tokens {
  id          BigInt    @id @default(autoincrement())
  user_id     Int
  sid         String    @unique(map: "uq_refresh_tokens_sid") @db.VarChar(32)
  token_hash  String    @db.Char(64)
  revoked_at  DateTime? @db.DateTime(0)
  replaced_by String?   @db.VarChar(32)
  device_id   String?   @db.VarChar(128)
  user_agent  String?   @db.VarChar(255)
  ip          String?   @db.VarChar(45)
  expires_at  DateTime  @db.DateTime(0)
  created_at  DateTime  @default(now()) @db.DateTime(0)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_refresh_tokens_user")

  @@index([user_id, revoked_at], map: "idx_refresh_tokens_user_revoked")
  @@index([expires_at], map: "idx_refresh_tokens_expires_at")
}

model reports {
  id              Int                     @id @default(autoincrement())
  reporter_id     Int
  reportable_type reports_reportable_type
  reportable_id   Int
  reason          String                  @db.VarChar(255)
  status          reports_status?         @default(pending)
  created_at      DateTime?               @default(now()) @db.DateTime(0)
  users           users                   @relation(fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reports_ibfk_1")

  @@index([reporter_id], map: "reporter_id")
}

model request_responses {
  id         Int                      @id @default(autoincrement())
  request_id Int
  user_id    Int
  shop_id    Int?
  product_id Int?
  message    String?                  @db.Text
  created_at DateTime?                @default(now()) @db.DateTime(0)
  status     request_responses_status @default(pending)

  @@index([request_id], map: "idx_rr_request")
  @@index([user_id], map: "idx_rr_user")
}

model roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique(map: "name") @db.VarChar(50)
  users users[]
}

model sales_invoices {
  id             Int                   @id @default(autoincrement())
  invoice_number String                @unique(map: "invoice_number") @db.VarChar(40)
  order_id       Int
  shop_id        Int
  client_id      Int
  commercial_id  Int?
  cashier_id     Int?
  amount         Decimal               @db.Decimal(12, 2)
  payment_method String?               @db.VarChar(50)
  status         sales_invoices_status @default(paid)
  created_at     DateTime?             @default(now()) @db.DateTime(0)
  paid_at        DateTime?             @db.DateTime(0)
  sent_at        DateTime?             @db.DateTime(0)
  orders         orders                @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "sales_invoices_ibfk_1")
  shops          shops                 @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "sales_invoices_ibfk_2")

  @@index([order_id], map: "order_id")
  @@index([shop_id], map: "shop_id")
}

model saved_posts {
  id         Int       @id @default(autoincrement())
  post_id    Int
  user_id    Int
  created_at DateTime? @default(now()) @db.DateTime(0)
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "saved_posts_ibfk_1")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "saved_posts_ibfk_2")

  @@unique([post_id, user_id], map: "unique_save")
  @@index([user_id], map: "user_id")
}

model settings {
  id            Int       @id @default(autoincrement())
  setting_key   String    @unique(map: "setting_key") @db.VarChar(100)
  setting_value String?   @db.Text
  updated_at    DateTime? @default(now()) @db.DateTime(0)
}

model shares {
  id         Int       @id @default(autoincrement())
  post_id    Int
  user_id    Int
  created_at DateTime? @default(now()) @db.DateTime(0)
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "shares_ibfk_1")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "shares_ibfk_2")

  @@index([post_id], map: "post_id")
  @@index([user_id], map: "user_id")
}

model shop_followers {
  id         Int       @id @default(autoincrement())
  shop_id    Int
  user_id    Int
  created_at DateTime? @default(now()) @db.DateTime(0)
  shops      shops     @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "shop_followers_ibfk_1")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "shop_followers_ibfk_2")

  @@unique([shop_id, user_id], map: "unique_follow")
  @@index([user_id], map: "user_id")
}

model shop_team_members {
  id         Int                         @id @default(autoincrement())
  shop_id    Int
  user_id    Int                         @unique(map: "user_id")
  team_role  shop_team_members_team_role @default(commercial)
  status     shop_team_members_status    @default(active)
  invited_by Int?
  created_at DateTime?                   @default(now()) @db.DateTime(0)
  shops      shops                       @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "shop_team_members_ibfk_1")
  users      users                       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "shop_team_members_ibfk_2")

  @@index([shop_id], map: "shop_id")
}

model shops {
  id                 Int                 @id @default(autoincrement())
  user_id            Int
  category_id        Int?
  name               String              @db.VarChar(150)
  slug               String              @unique(map: "slug") @db.VarChar(170)
  logo               String?             @db.VarChar(255)
  banner             String?             @db.VarChar(255)
  description        String?             @db.Text
  phone              String?             @db.VarChar(30)
  whatsapp           String?             @db.VarChar(30)
  facebook           String?             @db.VarChar(255)
  instagram          String?             @db.VarChar(255)
  city               String?             @db.VarChar(100)
  address            String?             @db.VarChar(255)
  latitude           Decimal?            @db.Decimal(10, 7)
  longitude          Decimal?            @db.Decimal(10, 7)
  delivery_radius_km Decimal?            @default(5.0) @db.Decimal(5, 1)
  opening_hours      String?             @db.VarChar(255)
  status             shops_status?       @default(pending)
  is_featured        Boolean?            @default(false)
  created_at         DateTime?           @default(now()) @db.DateTime(0)
  updated_at         DateTime?           @default(now()) @db.DateTime(0)
  advertisements     advertisements[]
  coupons            coupons[]
  orders             orders[]
  posts              posts[]
  products           products[]
  promotions         promotions[]
  refunds            refunds[]
  sales_invoices     sales_invoices[]
  shop_followers     shop_followers[]
  shop_team_members  shop_team_members[]
  categories         categories?         @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_shops_category")
  users              users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "shops_ibfk_1")
  statistics         statistics[]

  @@index([category_id], map: "fk_shops_category")
  @@index([user_id], map: "user_id")
}

model statistics {
  id           Int      @id @default(autoincrement())
  shop_id      Int
  date         DateTime @db.Date
  views        Int?     @default(0)
  orders_count Int?     @default(0)
  revenue      Decimal? @default(0.00) @db.Decimal(12, 2)
  shops        shops    @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "statistics_ibfk_1")

  @@index([shop_id], map: "shop_id")
}

model stories {
  id              Int               @id @default(autoincrement())
  user_id         Int
  media_path      String            @db.VarChar(255)
  type            stories_type?     @default(image)
  expires_at      DateTime          @db.DateTime(0)
  created_at      DateTime?         @default(now()) @db.DateTime(0)
  users           users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "stories_ibfk_1")
  story_reactions story_reactions[]
  story_views     story_views[]

  @@index([user_id], map: "user_id")
}

model story_reactions {
  id         Int                  @id @default(autoincrement())
  story_id   Int
  user_id    Int
  type       story_reactions_type @default(love)
  created_at DateTime?            @default(now()) @db.DateTime(0)
  stories    stories              @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "story_reactions_ibfk_1")
  users      users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "story_reactions_ibfk_2")

  @@unique([story_id, user_id], map: "unique_story_reaction")
  @@index([user_id], map: "user_id")
}

model story_views {
  id        Int       @id @default(autoincrement())
  story_id  Int
  user_id   Int
  viewed_at DateTime? @default(now()) @db.DateTime(0)
  stories   stories   @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "story_views_ibfk_1")
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "story_views_ibfk_2")

  @@unique([story_id, user_id], map: "unique_story_view")
  @@index([user_id], map: "user_id")
}

model user_presence {
  user_id   Int       @id
  is_online Boolean   @default(false)
  last_seen DateTime? @default(now()) @db.DateTime(0)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_presence_ibfk_1")
}

model users {
  id                                             Int                @id @default(autoincrement())
  role_id                                        Int                @default(3)
  admin_level                                    users_admin_level?
  firstname                                      String             @db.VarChar(100)
  lastname                                       String             @db.VarChar(100)
  email                                          String             @unique(map: "email") @db.VarChar(150)
  phone                                          String?            @db.VarChar(30)
  password                                       String             @db.VarChar(255)
  temp_password                                  String?            @db.VarChar(100)
  avatar                                         String?            @db.VarChar(255)
  cover                                          String?            @db.VarChar(255)
  bio                                            String?            @db.Text
  status                                         users_status?      @default(active)
  email_verified_at                              DateTime?          @db.DateTime(0)
  /// Ajoutée manuellement (mobile) — hors `prisma db pull`, voir refresh_tokens.
  phone_verified_at                              DateTime?          @db.DateTime(0)
  /// Invalide tout jeton d'accès émis avant cette date (mobile uniquement).
  sessions_invalid_before                        DateTime?          @db.DateTime(0)
  remember_token                                 String?            @db.VarChar(255)
  created_at                                     DateTime?          @default(now()) @db.DateTime(0)
  updated_at                                     DateTime?          @default(now()) @db.DateTime(0)
  birthdate                                      DateTime?          @db.Date
  gender                                         String?            @db.VarChar(10)
  com_notif_seen_at                              DateTime?          @db.DateTime(0)
  com_orders_seen_at                             DateTime?          @db.DateTime(0)
  addresses                                      addresses[]
  admin_logs                                     admin_logs[]
  cart                                           cart[]
  comments                                       comments[]
  conversations_conversations_user_one_idTousers conversations[]    @relation("conversations_user_one_idTousers")
  conversations_conversations_user_two_idTousers conversations[]    @relation("conversations_user_two_idTousers")
  favorites                                      favorites[]
  followers_followers_follower_idTousers         followers[]        @relation("followers_follower_idTousers")
  followers_followers_following_idTousers        followers[]        @relation("followers_following_idTousers")
  kyc_documents                                  kyc_documents[]
  logs                                           logs[]
  messages                                       messages[]
  notifications                                  notifications[]
  orders                                         orders[]
  post_preferences                               post_preferences[]
  posts                                          posts[]
  product_reviews                                product_reviews[]
  reactions                                      reactions[]
  refresh_tokens                                 refresh_tokens[]
  reports                                        reports[]
  saved_posts                                    saved_posts[]
  shares                                         shares[]
  shop_followers                                 shop_followers[]
  shop_team_members                              shop_team_members?
  shops                                          shops[]
  stories                                        stories[]
  story_reactions                                story_reactions[]
  story_views                                    story_views[]
  user_presence                                  user_presence?
  roles                                          roles              @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "users_ibfk_1")

  @@index([role_id], map: "role_id")
}

