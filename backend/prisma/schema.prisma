  users_reports_resolved_byTousers users?  @relation("reports_resolved_by", fields: [resolved_by], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_reports_resolved_by")
  sanctions       sanctions[]

  @@index([reporter_id], map: "reporter_id")
}

