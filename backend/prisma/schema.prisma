/// Ajoutée manuellement (mobile, Phase 6) — hors `prisma db pull`, voir refresh_tokens.
model courier_withdrawals {
  id         Int                        @id @default(autoincrement())
  courier_id Int
  amount     Decimal                    @db.Decimal(12, 2)
  method     String                     @db.VarChar(40)
  account    String                     @db.VarChar(120)
  status     courier_withdrawals_status @default(pending)
  created_at DateTime                   @default(now()) @db.DateTime(0)
  updated_at DateTime?                  @default(now()) @db.DateTime(0)
  users      users                      @relation(fields: [courier_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_courier_withdrawals_user")

  @@index([status], map: "idx_courier_withdrawals_status")
}

/// Ajoutée manuellement (mobile, Phase 6) — hors `prisma db pull`, voir refresh_tokens.
model courier_bonuses {
  id                                       Int      @id @default(autoincrement())
  courier_id                               Int
  amount                                   Decimal  @db.Decimal(12, 2)
  reason                                   String   @db.VarChar(300)
  granted_by                               Int
  created_at                               DateTime @default(now()) @db.DateTime(0)
  users_courier_bonuses_courier_idTousers  users    @relation("courier_bonuses_courier_id", fields: [courier_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_courier_bonuses_user")
  users_courier_bonuses_granted_byTousers  users    @relation("courier_bonuses_granted_by", fields: [granted_by], references: [id], onUpdate: Restrict, map: "fk_courier_bonuses_granted_by")

  @@index([courier_id, created_at], map: "idx_courier_bonuses_courier_created")
}

/// Ajoutée manuellement (mobile, Phase 6) — hors `prisma db pull`, voir refresh_tokens.
model merchant_withdrawals {
  id         Int                        @id @default(autoincrement())
  shop_id    Int
  owner_id   Int
  amount     Decimal                    @db.Decimal(12, 2)
  method     String                     @db.VarChar(40)
  account    String                     @db.VarChar(120)
  status     courier_withdrawals_status @default(pending)
  created_at DateTime                   @default(now()) @db.DateTime(0)
  updated_at DateTime?                  @default(now()) @db.DateTime(0)
  shops      shops                      @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_merchant_withdrawals_shop")
  users      users                      @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_merchant_withdrawals_owner")

  @@index([status], map: "idx_merchant_withdrawals_status")
}

/// Ajoutée manuellement (mobile, Phase 6) — hors `prisma db pull`, voir refresh_tokens.
/// Remplace la collection Mongo `stockMovements` (ADR 0002 levée : plus de
/// contrainte time-series/transaction incompatible une fois `shop_id`/`user_id`
/// des entiers MySQL directs comme le reste du domaine boutique).
model stock_movements {
  id            Int                   @id @default(autoincrement())
  shop_id       Int
  product_id    Int
  user_id       Int
  type          stock_movements_type
  reason        String                @db.VarChar(200)
  quantity      Int
  stock_before  Int
  stock_after   Int
  unit_cost     Decimal?              @db.Decimal(12, 2)
  supplier      String?               @db.VarChar(150)
  note          String?               @db.VarChar(300)
  at            DateTime              @default(now()) @db.DateTime(0)
  shops         shops                 @relation(fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_stock_movements_shop")
  products      products              @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_stock_movements_product")
  users         users                 @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_stock_movements_user")

  @@index([shop_id, at], map: "idx_stock_movements_shop_at")
  @@index([product_id, at], map: "idx_stock_movements_product_at")
}

/// Ajoutée manuellement (mobile, Phase 6) — hors `prisma db pull`, voir refresh_tokens.
/// Remplace `User.devices[]` (Mongo) — jetons FCM pour les notifications push.
model device_tokens {
  id            Int                  @id @default(autoincrement())
  user_id       Int
  device_id     String               @db.VarChar(150)
  fcm_token     String               @db.VarChar(300)
  platform      device_tokens_platform
  last_seen_at  DateTime?            @db.DateTime(0)
  users         users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_device_tokens_user")

  @@unique([user_id, device_id], map: "unique_device")
}

/// Ajoutée manuellement (mobile, Phase 6) — hors `prisma db pull`, voir refresh_tokens.
/// Remplace `User.courierProfile` (Mongo) — purement informatif, aucune règle
/// métier ne le consultait déjà avant cette bascule.
model courier_profiles {
  user_id           Int      @id
  identity_verified Boolean  @default(false)
  vehicle           String?  @db.VarChar(60)
  available         Boolean  @default(false)
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_courier_profiles_user")
}

