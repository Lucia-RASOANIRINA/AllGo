# AllGo API — variables d'environnement
# Copier en .env et renseigner. AUCUNE valeur réelle n'est versionnée (§12.1).

NODE_ENV=development
PORT=3000
API_PREFIX=v1

# --- MongoDB ---
# Le replica set est obligatoire : sans lui, pas de transaction multi-documents (§6.3).
MONGODB_URI=mongodb://localhost:27017/allgo?replicaSet=rs0&directConnection=true

# --- Redis (cache, BullMQ, sessions WebSocket) ---
REDIS_URL=redis://localhost:6379

# --- JWT (§5.1) ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- Stockage objet compatible S3 (§7.4) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=allgo-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/allgo-media

# --- CORS : origines autorisées, séparées par des virgules ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Version minimale d'application supportée (§17.3) ---
MIN_SUPPORTED_APP_VERSION=1.0.0

# --- Paiements mobile money (§14) ---
MVOLA_BASE_URL=
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_MERCHANT_MSISDN=
MVOLA_WEBHOOK_SECRET=

ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=

AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_WEBHOOK_SECRET=

# --- Notifications push ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Supervision ---
SENTRY_DSN=
LOG_LEVEL=debug
