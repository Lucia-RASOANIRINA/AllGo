# AllGo API — variables d'environnement
# Copier en .env et renseigner. AUCUNE valeur réelle n'est versionnée (§12.1).

NODE_ENV=development
PORT=3000
API_PREFIX=v1

# --- URL publique de CETTE API (construit les liens de téléversement média) ---
API_PUBLIC_BASE_URL=http://localhost:3000/v1

# --- Redis (cache, jetons de téléversement, verrous de connexion, sessions WebSocket) ---
REDIS_URL=redis://localhost:6379

# --- JWT (§5.1) ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- Stockage média — disque local (§7.4, décision du 2026-09-10) ---
# En production (o2switch) : `MEDIA_STORAGE_PATH` doit pointer sur le dossier
# `public/` du site web historique (PAS `public/uploads` directement : les
# clés générées commencent déjà par `uploads/...`, cf. `MediaService.createUploadUrl`),
# et `MEDIA_PUBLIC_BASE_URL` sur le domaine seul, sans suffixe — sinon les
# publications importées par l'ancien site (dont `file_path` pointe vers
# `public/uploads/...`) restent introuvables alors que le site web les
# affiche correctement (même dossier, mais jamais le même que celui utilisé
# par cette API auparavant, `mediaAllGo`, qui n'a jamais contenu ces fichiers).
MEDIA_STORAGE_PATH=./public
MEDIA_PUBLIC_BASE_URL=http://localhost:3000

# --- CORS : origines autorisées, séparées par des virgules ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Version minimale d'application supportée (§17.3) ---
MIN_SUPPORTED_APP_VERSION=1.0.0

# --- SMS (OTP, mot de passe oublié) — absent tant qu'aucun fournisseur n'est
# branché : l'API répond alors une indisponibilité explicite plutôt qu'un SMS
# jamais envoyé (§ décision du 2026-09-09, mise en marché). ---
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=

# --- Paiements mobile money (§14) ---
MVOLA_BASE_URL=
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_MERCHANT_MSISDN=
MVOLA_WEBHOOK_SECRET=

ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=

AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_WEBHOOK_SECRET=

# Mode démo (succès simulé sans appel réseau) — UNIQUEMENT hors production, et
# seulement si explicitement activé ici. Ne JAMAIS définir en production : son
# absence est le second verrou qui empêche un faux paiement de passer pour
# réussi (§ décision du 2026-09-09, mise en marché).
PAYMENTS_DEMO_MODE=

# --- Notifications push ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Supervision ---
SENTRY_DSN=
LOG_LEVEL=debug
